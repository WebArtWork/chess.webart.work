rules_version = '2';

// waw chess. Everything is denied unless a rule below allows it.
// Deploy with: npm run rules
service cloud.firestore {
	match /databases/{database}/documents {
		function signedIn() {
			return request.auth != null;
		}

		function isOwner(uid) {
			return signedIn() && request.auth.uid == uid;
		}

		function stringUpTo(value, max) {
			return value is string && value.size() <= max;
		}

		// users/{uid}: identity copied from the Google account. Mirrors src/app/feature/account.
		function validProfile(data) {
			return data.keys().hasOnly(['displayName', 'email', 'photoUrl', 'createdAt', 'updatedAt'])
				&& stringUpTo(data.displayName, 200)
				&& stringUpTo(data.email, 320)
				&& stringUpTo(data.photoUrl, 2048)
				&& data.createdAt is timestamp
				&& data.updatedAt is timestamp;
		}

		// users/{uid}/games/{id}: a game saved from the Library. Never edited after saving.
		function validGame(data) {
			return data.keys().hasOnly(['title', 'startFen', 'sans', 'fen', 'createdAt'])
				&& stringUpTo(data.title, 200)
				&& stringUpTo(data.startFen, 100)
				&& stringUpTo(data.fen, 100)
				&& data.sans is list
				&& data.sans.size() <= 600
				&& data.createdAt is timestamp;
		}

		// classes/{id}: a weekly training class. Mirrors src/app/feature/classroom. The owner edits it;
		// class mates are listed by email and can read it once they sign in with that verified email.
		// isPublic is stored but grants nothing yet: showing a class to everyone needs the mate list
		// kept out of the public document first.
		function isMate(data) {
			return signedIn()
				&& request.auth.token.email_verified == true
				&& request.auth.token.email in data.emails;
		}

		function validClass(data) {
			return data.keys().hasOnly(['title', 'ownerUid', 'ownerName', 'ownerEmail', 'days', 'time', 'duration', 'timeControl', 'isPublic', 'emails', 'createdAt', 'updatedAt'])
				&& stringUpTo(data.title, 200) && data.title.size() > 0
				&& data.ownerUid == request.auth.uid
				// the creator's name and email, copied so class mates can see who leads the class;
				// optional because classes saved before this existed have neither
				&& (!('ownerName' in data) || stringUpTo(data.ownerName, 200))
				&& (!('ownerEmail' in data) || stringUpTo(data.ownerEmail, 320))
				&& data.days is list && data.days.size() >= 1 && data.days.size() <= 7
				&& stringUpTo(data.time, 5)
				&& data.duration is int && data.duration >= 5 && data.duration <= 600
				&& stringUpTo(data.timeControl, 10)
				&& data.isPublic is bool
				&& data.emails is list && data.emails.size() <= 200
				&& data.updatedAt == request.time;
		}

		match /classes/{classId} {
			allow read: if signedIn()
				&& (resource.data.ownerUid == request.auth.uid || isMate(resource.data));
			allow create: if signedIn()
				&& validClass(request.resource.data)
				&& request.resource.data.createdAt == request.time;
			allow update: if signedIn()
				&& resource.data.ownerUid == request.auth.uid
				&& validClass(request.resource.data)
				&& request.resource.data.createdAt == resource.data.createdAt;
			allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

			// The class's own document says who the owner and the class mates are.
			function classDoc() {
				return get(/databases/$(database)/documents/classes/$(classId)).data;
			}

			function isClassOwner() {
				return signedIn() && classDoc().ownerUid == request.auth.uid;
			}

			function isClassMember() {
				return isClassOwner() || isMate(classDoc());
			}

			// classes/{id}/lessons/{lessonId}: one sitting. The owner opens it and ends the tournament.
			// Mirrors src/app/feature/classroom/lesson.service.ts.
			function lessonOpen(lessonId) {
				return get(/databases/$(database)/documents/classes/$(classId)/lessons/$(lessonId)).data.status == 'open';
			}

			match /lessons/{lessonId} {
				allow read: if isClassMember();
				allow create: if isClassOwner()
					&& request.resource.data.keys().hasOnly(['status', 'createdAt'])
					&& request.resource.data.status == 'open'
					&& request.resource.data.createdAt == request.time;
				allow update: if isClassOwner()
					&& resource.data.status == 'open'
					&& request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'finishedAt'])
					&& request.resource.data.status == 'finished'
					&& request.resource.data.finishedAt == request.time;

				// a member who opened the lesson: their name, the opening picked for them and Ready
				match /players/{uid} {
					allow read: if isClassMember();
					allow create, update: if isClassMember()
						&& request.auth.uid == uid
						&& lessonOpen(lessonId)
						&& request.resource.data.keys().hasOnly(['uid', 'name', 'openingId', 'ready', 'updatedAt'])
						&& request.resource.data.uid == uid
						&& stringUpTo(request.resource.data.name, 200)
						&& stringUpTo(request.resource.data.openingId, 40)
						&& request.resource.data.ready is bool
						&& request.resource.data.updatedAt == request.time;
					// account deletion
					allow delete: if signedIn() && (request.auth.uid == uid || isClassOwner());
				}

				// One pairing of a round. The owner creates it (a bye has no black player); the two players
				// make the moves in turn and end it. Moves are checked by the app with chess.js.
				match /games/{gameId} {
					function before() {
						return resource.data;
					}

					function after() {
						return request.resource.data;
					}

					function changed() {
						return after().diff(before()).affectedKeys();
					}

					function isPlayer() {
						return signedIn() && (request.auth.uid == before().white || request.auth.uid == before().black);
					}

					function moverUid() {
						return before().moves.size() % 2 == 0 ? before().white : before().black;
					}

					function moverSide() {
						return before().moves.size() % 2 == 0 ? 'white' : 'black';
					}

					function validNewGame(data) {
						return data.keys().hasOnly(['round', 'white', 'black', 'whiteName', 'blackName', 'whiteOpening', 'blackOpening', 'moves', 'whiteMs', 'blackMs', 'lastMoveAt', 'result', 'reason', 'drawOffer', 'createdAt'])
							&& data.round is int && data.round >= 1 && data.round <= 100
							&& stringUpTo(data.white, 128)
							&& (data.black == null || (stringUpTo(data.black, 128) && data.black != data.white))
							&& stringUpTo(data.whiteName, 200)
							&& (data.black == null || stringUpTo(data.blackName, 200))
							&& stringUpTo(data.whiteOpening, 40)
							&& stringUpTo(data.blackOpening, 40)
							&& data.moves is list && data.moves.size() == 0
							&& data.whiteMs is int && data.whiteMs >= 0 && data.whiteMs <= 10800000
							&& data.blackMs is int && data.blackMs >= 0 && data.blackMs <= 10800000
							&& data.lastMoveAt == request.time
							&& data.createdAt == request.time
							&& data.reason == null
							&& data.drawOffer == null
							&& (data.black == null ? data.result == 'bye' : data.result == null);
					}

					// a move: one more entry, by the side to move, ending the game only in a way the move shows
					function isMove() {
						return changed().hasOnly(['moves', 'whiteMs', 'blackMs', 'lastMoveAt', 'drawOffer', 'result', 'reason'])
							&& changed().hasAll(['moves', 'lastMoveAt'])
							&& request.auth.uid == moverUid()
							&& after().moves.size() == before().moves.size() + 1
							&& after().moves.hasAll(before().moves)
							&& after().lastMoveAt == request.time
							&& after().whiteMs is int && after().whiteMs >= 0 && after().whiteMs <= 10800000
							&& after().blackMs is int && after().blackMs >= 0 && after().blackMs <= 10800000
							&& after().drawOffer == null
							&& (
								(after().result == null && after().reason == null)
								|| (after().reason == 'checkmate' && after().result == moverSide())
								|| ((after().reason == 'stalemate' || after().reason == 'draw') && after().result == 'draw')
							);
					}

					// the end of a game without a move: resigning, accepting a draw, or a clock that ran out
					function isEnding() {
						return changed().hasOnly(['result', 'reason', 'drawOffer'])
							&& changed().hasAll(['result', 'reason'])
							&& after().drawOffer == null
							&& (
								(after().reason == 'resign' && after().result == (request.auth.uid == before().white ? 'black' : 'white'))
								|| (after().reason == 'agreement' && after().result == 'draw'
									&& before().drawOffer != null && before().drawOffer != request.auth.uid)
								|| (after().reason == 'time' && before().moves.size() >= 2
									&& after().result == (moverSide() == 'white' ? 'black' : 'white')
									&& request.time.toMillis() - before().lastMoveAt.toMillis() >= (moverSide() == 'white' ? before().whiteMs : before().blackMs) - 1000)
							);
					}

					function isOffer() {
						return changed().hasOnly(['drawOffer'])
							&& (after().drawOffer == request.auth.uid || after().drawOffer == null);
					}

					allow read: if isClassMember();
					allow create: if isClassOwner() && lessonOpen(lessonId) && validNewGame(request.resource.data);
					allow update: if isPlayer()
						&& before().result == null
						&& before().black != null
						&& (isMove() || isEnding() || isOffer());
					// account deletion
					allow delete: if isClassOwner();
				}
			}
		}

		// users/{uid}/openings/{openingId}: an opening the student met in a class and used in a game there.
		// The class lesson skips these when it picks what to teach next.
		match /users/{uid}/openings/{openingId} {
			allow read: if isOwner(uid);
			allow create, update: if isOwner(uid)
				&& stringUpTo(openingId, 40)
				&& request.resource.data.keys().hasOnly(['classId', 'createdAt'])
				&& stringUpTo(request.resource.data.classId, 128)
				&& request.resource.data.createdAt == request.time;
			allow delete: if isOwner(uid);
		}

		match /users/{uid}/games/{gameId} {
			allow read: if isOwner(uid);
			allow create: if isOwner(uid)
				&& validGame(request.resource.data)
				&& request.resource.data.createdAt == request.time;
			allow delete: if isOwner(uid);
		}

		// Puzzle rating and pawns. Mirrors src/app/feature/progress. The app works out each change;
		// the rules only let it through as one step: a new users/{uid}/events/{id} (created once,
		// never edited, so nothing earns twice) and the matching update of progress/current in the
		// same batch. A rated event must follow the Elo formula of progress.const.ts.
		function progressPath(uid) {
			return /databases/$(database)/documents/users/$(uid)/progress/current;
		}

		function eventPath(uid, id) {
			return /databases/$(database)/documents/users/$(uid)/events/$(id);
		}

		function validProgress(data) {
			return data.keys().hasOnly(['rating', 'best', 'rated', 'pawns', 'lastEvent', 'updatedAt'])
				&& data.rating is int && data.rating >= 100 && data.rating <= 4000
				&& data.best is int && data.best >= data.rating && data.best <= 4000
				&& data.rated is int && data.rated >= 0
				&& data.pawns is int && data.pawns >= 0
				&& stringUpTo(data.lastEvent, 150)
				&& data.updatedAt == request.time;
		}

		// pawns up to MAX_PAWNS; unrated events change only pawns
		function validEvent(data) {
			return data.keys().hasOnly(['delta', 'score', 'puzzleRating', 'pawns', 'createdAt'])
				&& data.pawns is int && data.pawns >= 0 && data.pawns <= 40
				&& data.delta is int
				&& (
					(data.puzzleRating == null && data.score == null && data.delta == 0)
					|| (data.puzzleRating is int && data.puzzleRating >= 100 && data.puzzleRating <= 4000
						&& data.score is number && data.score >= 0 && data.score <= 1)
				)
				&& data.createdAt == request.time;
		}

		// Elo with K 48 for the first 20 rated puzzles, then 24; rounding and the ±1 minimum
		// stay within 1.5, the floor of 100 may cut a loss short
		function fairDelta(before, event) {
			let k = before.rated < 20 ? 48 : 24;
			let expected = 1 / (1 + math.pow(10, (event.puzzleRating - before.rating) / 400.0));
			return math.abs(event.delta - k * (event.score - expected)) <= 1.5
				|| (before.rating + event.delta == 100 && event.delta >= -k);
		}

		function progressStep(uid, before, after) {
			let path = eventPath(uid, after.lastEvent);
			return after.lastEvent != before.lastEvent
				&& !exists(path)
				&& existsAfter(path)
				&& progressMatches(before, after, getAfter(path).data);
		}

		function progressMatches(before, after, event) {
			return after.pawns == before.pawns + event.pawns
				&& after.rating == before.rating + event.delta
				&& after.rated == before.rated + (event.puzzleRating == null ? 0 : 1)
				&& after.best == (after.rating > before.best ? after.rating : before.best)
				&& (event.puzzleRating == null || fairDelta(before, event));
		}

		match /users/{uid}/progress/{docId} {
			allow read: if isOwner(uid);
			// a new account starts from what was earned as a guest
			allow create: if isOwner(uid)
				&& docId == 'current'
				&& validProgress(request.resource.data)
				&& request.resource.data.lastEvent == '';
			allow update: if isOwner(uid)
				&& docId == 'current'
				&& validProgress(request.resource.data)
				&& progressStep(uid, resource.data, request.resource.data);
			// account deletion
			allow delete: if isOwner(uid);
		}

		match /users/{uid}/events/{eventId} {
			allow read: if isOwner(uid);
			allow create: if isOwner(uid)
				&& validEvent(request.resource.data)
				&& getAfter(progressPath(uid)).data.lastEvent == eventId;
			// account deletion
			allow delete: if isOwner(uid);
		}

		match /users/{uid} {
			allow read: if isOwner(uid);
			allow create: if isOwner(uid)
				&& validProfile(request.resource.data)
				&& request.resource.data.createdAt == request.time
				&& request.resource.data.updatedAt == request.time;
			allow update: if isOwner(uid)
				&& validProfile(request.resource.data)
				&& request.resource.data.createdAt == resource.data.createdAt
				&& request.resource.data.updatedAt == request.time;
			allow delete: if isOwner(uid);
		}
	}
}
