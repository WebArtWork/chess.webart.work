{
	"name": "app",
	"version": "22.0.1",
	"scripts": {
		"start": "ng serve",
		"build": "ng build --configuration=production",
		"build:seo": "npm run build && node tools/seo/generate-static-seo.mjs",
		"rules": "firebase deploy --only firestore:rules --project chess-d92e1",
		"games:extract": "node tools/games/extract-games.mjs",
		"games:analyze": "node tools/games/analyze-games.mjs",
		"games:import": "tsc -p tools/chess-import/tsconfig.json && vitest run --config tools/chess-import/vitest.config.ts --silent && node --disable-warning=ExperimentalWarning tools/chess-import/src/cli.ts",
		"games:clear": "node --disable-warning=ExperimentalWarning tools/chess-import/src/cli.ts clear",
		"games:wipe": "node --disable-warning=ExperimentalWarning tools/chess-import/src/cli.ts wipe",
		"games:refresh": "node --disable-warning=ExperimentalWarning tools/chess-import/src/cli.ts refresh",
		"games:lookahead": "node --disable-warning=ExperimentalWarning tools/chess-import/src/cli.ts lookahead",
		"games:import:sample": "node --disable-warning=ExperimentalWarning tools/chess-import/src/cli.ts --max-scan 3000 --max-export 20 --work-dir tools/chess-import/.work/sample --output tools/chess-import/.work/sample/out/games.json"
	},
	"dependencies": {
		"@angular/common": "22.2.1",
		"@angular/compiler": "22.2.1",
		"@angular/core": "22.2.1",
		"@angular/forms": "22.2.1",
		"@angular/platform-browser": "22.2.1",
		"@angular/platform-server": "22.2.1",
		"@angular/router": "22.2.1",
		"@angular/ssr": "22.2.2",
		"@lichess-org/chessground": "^10.1.0",
		"@wawjs/ngx-core": "22.0.9",
		"@wawjs/ngx-default": "22.0.3",
		"@wawjs/ngx-translate": "22.0.9",
		"@wawjs/ngx-ui": "22.0.9",
		"chess.js": "^1.4.0",
		"express": "5.1.0",
		"firebase": "^13.0.0",
		"rxjs": "7.8.0",
		"stockfish": "^18.0.5",
		"tslib": "2.3.0"
	},
	"devDependencies": {
		"@angular/build": "22.2.2",
		"@angular/cli": "22.2.2",
		"@angular/compiler-cli": "22.2.1",
		"@tailwindcss/postcss": "4.1.12",
		"@types/express": "5.0.1",
		"@types/node": "25.9.3",
		"ng-packagr": "22.2.4",
		"postcss": "8.5.26",
		"prettier": "3.8.1",
		"tailwindcss": "4.1.12",
		"typescript": "6.0.3",
		"vitest": "5.0.3"
	},
	"overrides": {
		"esbuild": "0.28.2",
		"@hono/node-server": "2.1.4"
	}
}
