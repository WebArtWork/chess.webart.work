{
	"name": "app",
	"version": "22.0.1",
	"license": "GPL-3.0-or-later",
	"scripts": {
		"start": "ng serve",
		"build": "ng build --configuration=production && node tools/licenses/copy-licenses.mjs",
		"build:seo": "npm run seo:check-images && npm run build && node tools/seo/generate-static-seo.mjs && node tools/seo/check-images.mjs --built",
		"seo:check-images": "node tools/seo/check-images.mjs",
		"rules": "firebase deploy --only firestore:rules --project chess-d92e1",
		"theories:md": "node tools/theory/export-md.mjs",
		"games:extract": "node tools/games/extract-games.mjs",
		"games:analyze": "node tools/games/analyze-games.mjs",
		"games:import": "tsc -p tools/chess-import/tsconfig.json && vitest run --config tools/chess-import/vitest.config.ts --silent && node --disable-warning=ExperimentalWarning tools/chess-import/src/cli.ts",
		"games:clear": "node --disable-warning=ExperimentalWarning tools/chess-import/src/cli.ts clear",
		"games:wipe": "node --disable-warning=ExperimentalWarning tools/chess-import/src/cli.ts wipe",
		"games:refresh": "node --disable-warning=ExperimentalWarning tools/chess-import/src/cli.ts refresh",
		"games:lookahead": "node --disable-warning=ExperimentalWarning tools/chess-import/src/cli.ts lookahead",
		"games:enrich": "node --disable-warning=ExperimentalWarning tools/chess-import/src/cli.ts enrich",
		"games:import:sample": "node --disable-warning=ExperimentalWarning tools/chess-import/src/cli.ts --max-scan 3000 --max-export 20 --work-dir tools/chess-import/.work/sample --output tools/chess-import/.work/sample/out/games.json --app-dir tools/chess-import/.work/sample/app --history tools/chess-import/.work/sample/history.json"
	},
	"dependencies": {
		"@angular/aria": "^22.2.6",
		"@angular/cdk": "^22.2.6",
		"@angular/common": "22.2.5",
		"@angular/compiler": "22.2.5",
		"@angular/core": "22.2.5",
		"@angular/forms": "22.2.5",
		"@angular/platform-browser": "22.2.5",
		"@angular/platform-server": "22.2.5",
		"@angular/router": "22.2.5",
		"@angular/ssr": "22.2.6",
		"@capacitor-firebase/authentication": "^8.6.0",
		"@capacitor/android": "^8.6.0",
		"@capacitor/app": "^8.1.2",
		"@capacitor/core": "^8.6.0",
		"@capacitor/ios": "^8.6.0",
		"@capacitor/share": "^8.0.3",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/inter-tight": "^5.3.0",
		"@lichess-org/chessground": "^10.5.0",
		"@wawjs/ngx-core": "22.0.11",
		"@wawjs/ngx-default": "22.0.3",
		"@wawjs/ngx-translate": "22.0.11",
		"@wawjs/ngx-ui": "22.0.11",
		"chess.js": "^1.4.0",
		"express": "5.3.0",
		"firebase": "^13.2.0",
		"jsqr": "^1.4.0",
		"qrcode": "^1.5.4",
		"rxjs": "7.8.2",
		"stockfish": "^18.0.8",
		"tslib": "2.9.1"
	},
	"devDependencies": {
		"@angular/build": "22.2.6",
		"@angular/cli": "22.2.6",
		"@angular/compiler-cli": "22.2.5",
		"@capacitor/cli": "^8.6.0",
		"@tailwindcss/postcss": "4.3.5",
		"@types/express": "5.0.6",
		"@types/node": "25.9.9",
		"@types/qrcode": "^1.5.6",
		"ng-packagr": "22.2.6",
		"postcss": "8.5.32",
		"prettier": "3.9.10",
		"tailwindcss": "4.3.5",
		"typescript": "6.0.3",
		"vitest": "5.1.0"
	},
	"overrides": {
		"esbuild": "0.28.2",
		"@hono/node-server": "2.1.4",
		"@grpc/grpc-js": "1.14.6",
		"body-parser": "^2.3.1",
		"fast-uri": "^3.1.9",
		"glob": "^14.0.2",
		"minimatch": "^11.0.1",
		"re2js": "^2.8.7",
		"uuid": "^11.1.1",
		"vite": "^8.3.3",
		"zod": "^4.6.6"
	}
}
